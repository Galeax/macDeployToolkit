#!/bin/sh
#
# macadt-deploy — macOS POST-INSTALL script, STANDALONE MODEL. GENERATED BY MACADT.
# DO NOT EDIT BY HAND.
#
# Destination: `postInstallScript` field of an Intune application of type
# `#microsoft.graph.macOSPkgApp`.
#
# TOKENS TO SUBSTITUTE — names given without their marker, since substitution
# also applies to comments:
#   PACKAGE_KEY   stable deployment key
#   DEPLOY_MODE   Interactive | NonInteractive | Silent
#
# ---------------------------------------------------------------------------
# WHY THE GATE IS HERE AND NOT IN PRE-INSTALL
#
# The pkg is self-contained: it carries the agent, the manifest, the hooks and
# the vendor's payload. There can therefore be NO gate in pre-install — that
# script would run before `installer`, hence before the agent exists on a fresh
# device.
#
# Consequence: `macadt-deploy install` does everything here, in order — dialog,
# deferral, closing the applications, then installing the payload.
#
# WHAT THIS SHIFTS: the deferral strategy assumes Intune retries after a
# non-zero exit. That assumption used to apply to the pre-install; it now
# applies to this script. To verify with probe-app-postinstall.sh BEFORE
# packaging at scale — if Intune marks the application as a permanent failure
# instead of retrying, a user who defers will never receive their package.
# ---------------------------------------------------------------------------
#
# THE MODE COMES FROM HERE, NOT THE PKG. This script is a property of the
# Intune application, not of the package content: it is the macOS equivalent of
# the Windows install command line. Changing mode is done by regenerating this
# script, without rebuilding or re-uploading the pkg. The manifest `mode` is
# only a fallback default — the precedence order is manifest < subcommand < flag.
#
# ---------------------------------------------------------------------------
# CRITICAL ROLE: the translation of codes 70-72.
#
# `macadt-deploy install` exits 70/71/72 when the installation SUCCEEDED but a
# system action is still required — the equivalent of Windows code 3010. Intune
# does not know this nuance: any non-zero code moves the application to
# "failed", and it would retry installing an already-installed package. We
# therefore translate 70-72 to 0, leaving the trace in the log and the state
# store.
#
# Do not remove this translation without checking what your tenant does.
# ---------------------------------------------------------------------------

set -u

AGENT_DIR="/usr/local/macadt"
AGENT="$AGENT_DIR/macadt-deploy"
# swiftDialog embedded in the pkg: no binary to pre-install on the device.
DIALOG="$AGENT_DIR/Dialog.app/Contents/MacOS/Dialog"
DEPLOY_ROOT="/Library/Application Support/MacADT/Deploy"
MANIFEST_DIR="$DEPLOY_ROOT/manifests/{##PACKAGE_KEY##}"
MANIFEST="$MANIFEST_DIR/manifest.json"

log() { echo "macadt-deploy-postinstall: $*" >&2; }

# ---------------------------------------------------------------------------
# CLEANUP — the PSADT model to the end: bring, run, remove.
#
# WHAT GOES: the agent's two binaries and the manifest directory, payload
# included. The pkg will lay them down again on the next attempt, so nothing is
# lost — and the device keeps no dead DMG.
#
# WHAT STAYS, AND THIS IS VITAL:
#
#   - `state.plist`, which carries the deferral counters. It lives in
#     DEPLOY_ROOT and NOT in the manifest directory, which makes the separation
#     natural. Deleting it would give the user back their deferrals on EVERY
#     attempt: the window would never exhaust, the gate would never lift, and
#     the deployment would spin indefinitely.
#   - the logs, in /var/log/MacADT/deploy.log and /var/log/MacADT/.
#
# WHAT THIS COSTS: `macadt-deploy status --json` is no longer available on the
# device between deployments. Diagnostics then go through
#   plutil -p "/Library/Application Support/MacADT/Deploy/state.plist"
# and the logs, both kept.
#
# We clean up ONLY on success. As long as a deferral is in progress, everything
# stays in place: the next attempt has less to do, and the device stays diagnosable.
# ---------------------------------------------------------------------------
cleanup() {
  # Safeguard: this `rm -rf` runs as root. An empty PACKAGE_KEY would give
  # ".../manifests/" and take out the manifests of ALL applications.
  case "$MANIFEST_DIR" in
    "$DEPLOY_ROOT/manifests/"?*) ;;
    *) log "unexpected manifest path, cleanup aborted: $MANIFEST_DIR"
       return 0 ;;
  esac

  # The completion message is a detached swiftDialog still on screen at this
  # point (20 s timer). Deleting its bundle under it makes the window lose its
  # background colour — it turns see-through (seen on macOS 26). So wait for our
  # own copy to exit; bounded, so a stuck dialog never holds the script up.
  waited=0
  while [ "$waited" -lt 30 ] && pgrep -f "$DIALOG" >/dev/null 2>&1; do
    sleep 1
    waited=$((waited + 1))
  done
  pkill -f "$DIALOG" 2>/dev/null || true

  rm -rf "$MANIFEST_DIR"
  rm -rf "$AGENT_DIR/Dialog.app"
  rm -f "$AGENT_DIR/macadt-deploy" "$AGENT_DIR/macadt-deploy-ui"
  rmdir "$AGENT_DIR" 2>/dev/null || true
  log "macadt-deploy files removed — state and logs kept"
}

# Unlike the shared-agent model, an absence here is a REAL error: both files are
# in the pkg that `installer` just laid down. Exiting 0 would mask a failed
# installation and Intune would declare the application installed.
if [ ! -x "$AGENT" ]; then
  log "agent missing from $AGENT although the pkg is supposed to install it"
  exit 1
fi
if [ ! -f "$MANIFEST" ]; then
  log "manifest missing from $MANIFEST although the pkg is supposed to lay it down"
  exit 1
fi

# --show-when-not-running governs whether an `interactive` deployment still shows a
# gate when NO blocking app is open: "true" shows an install notice with a countdown,
# "false" installs silently in that case. Overridable here without rebuilding the pkg,
# exactly like the mode above — flip the value and re-upload this script alone.
"$AGENT" install --manifest "$MANIFEST" --mode "{##DEPLOY_MODE##}" \
         --show-when-not-running "{##SHOW_WHEN_NOT_RUNNING##}" --dialog "$DIALOG"
CODE=$?

case $CODE in
  0)
    log "installation complete"
    cleanup
    exit 0
    ;;
  70|71|72)
    log "installation succeeded, system action required (internal code $CODE)"
    cleanup
    exit 0
    ;;
  60)
    # User deferral. Non-zero ON PURPOSE: it is the only way to ask Intune to
    # retry. The application will show up as "failed" in the dashboard, which is
    # unreadable but functionally correct — the source of truth is
    # `macadt-deploy status --json`.
    log "user deferral, Intune retry expected"
    log "files kept until the deployment completes"
    exit $CODE
    ;;
  *)
    log "installation failed (code $CODE)"
    exit $CODE
    ;;
esac
